# Managed by ops/stalwart/ansible/playbooks/stalwart.yml -- hand-edit only if you know the
# install.sh installer will preserve this file on re-run (it does, per its own real, current
# source: "Create env file if absent (preserve user edits on reinstall)").

STALWART_HOSTNAME={{ stalwart_hostname }}
STALWART_PUBLIC_URL={{ stalwart_public_url }}

# Pins a known recovery-admin credential instead of leaving a temporary, random one buried in
# `journalctl -u stalwart` output that's only ever printed once.
STALWART_RECOVERY_ADMIN={{ stalwart_recovery_admin_user }}:{{ stalwart_recovery_admin_password }}
